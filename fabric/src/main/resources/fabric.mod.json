{
  "schemaVersion": 1,
  "id": "asr",
  "version": "${version}",
  "name": "Asgard Shield: Reloaded",
  "description": "A Hexxit mod ported over to new Minecraft Versions. Includes Giant Swords and Asgard Shields!",
  "authors": [
    "ManGregory, ACGaming"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/asgard-shield-reloaded",
    "sources": "https://github.com/ManGregory128/asgardshieldreloaded",
    "issues": "https://github.com/ManGregory128/asgardshieldreloaded/issues"
  },
  "license": " GPL-3.0",
  "icon": "asr.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "me.mangregory.asr.fabric.AsgardShieldReloadedFabric"
    ],
    "client": [
      "me.mangregory.asr.fabric.client.AsgardShieldReloadedFabricClient"
    ],
    "fabric-datagen": [
      "me.mangregory.asr.fabric.client.AsgardShieldReloadedDataGen"
    ],
    "jei_mod_plugin": [
      "me.mangregory.asr.fabric.compat.jei.ASRJeiPlugin"
    ],
    "modmenu": [
      "me.mangregory.asr.fabric.compat.modmenu.AsrModMenuApi"
    ]
  },
  "mixins": [
    "asr.mixins.json"
  ],
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=0.14.21",
    "minecraft": "~1.19.2",
    "java": ">=17",
    "architectury": ">=6.5.90",
    "fabric-api": "*",
    "resourcefulconfig": ">=1.0.20"
  }
}
